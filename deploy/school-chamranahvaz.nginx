# /etc/nginx/sites-available/school-chamranahvaz
# دامنهٔ جدید mdresx.fun (مهاجرت 2026-10-09) — هر ۶ ساب‌دامنه
# حفظ اصلاحات آدیت: HSTS (F-006) + limit_req on admin login (F-005)

server {
    listen 80;
    server_name ghjs.mdresx.fun dtga.mdresx.fun avel.mdresx.fun avvdy.mdresx.fun otv2.mdresx.fun ovyi.mdresx.fun;
    return 301 https://$host$request_uri;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ghjs.mdresx.fun dtga.mdresx.fun avel.mdresx.fun avvdy.mdresx.fun otv2.mdresx.fun ovyi.mdresx.fun;

    ssl_certificate /root/.acme.sh/mdresx.fun_ecc/fullchain.cer;
    ssl_certificate_key /root/.acme.sh/mdresx.fun_ecc/mdresx.fun.key;

    # HSTS — رفع F-006
    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;

    # rate limit روی لاگین ادمین — رفع F-005 (5r/m، burst 3؛ 429 در تجاوز)
    location = /api/admin/login {
        limit_req zone=admin_login burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3111;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        proxy_pass http://127.0.0.1:3111;
        proxy_set_header Host $host;
    }
}
