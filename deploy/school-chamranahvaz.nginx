# /etc/nginx/sites-available/school-chamranahvaz
# audit fixes 2026-10-09: HSTS (F-006) + limit_req on admin login (F-005)

server {
    listen 80;
    server_name ghjs.tdnvzgg66.shop dtga.tdnvzgg66.shop avel.tdnvzgg66.shop avvdy.tdnvzgg66.shop otv2.tdnvzgg66.shop ovyi.tdnvzgg66.shop;
    return 301 https://$host$request_uri;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ghjs.tdnvzgg66.shop dtga.tdnvzgg66.shop avel.tdnvzgg66.shop avvdy.tdnvzgg66.shop otv2.tdnvzgg66.shop ovyi.tdnvzgg66.shop;

    ssl_certificate /root/.acme.sh/tdnvzgg66.shop_ecc/fullchain.cer;
    ssl_certificate_key /root/.acme.sh/tdnvzgg66.shop_ecc/tdnvzgg66.shop.key;

    # HSTS — رفع F-006 (حداقل ۶ ماه؛ بعد از تأیید کارکرد قابل افزایش به ۱ سال)
    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;

    # rate limit روی لاگین ادمین — رفع F-005 (5r/m، burst 3؛ 429 در تجاوز)
    location = /api/admin/login {
        limit_req zone=admin_login burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3111;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        proxy_pass http://127.0.0.1:3111;
        proxy_set_header Host $host;
    }
}
