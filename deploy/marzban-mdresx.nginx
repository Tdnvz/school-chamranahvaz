# marzban panel + sub on mdresx.online
server {
    listen 80;
    server_name marzban.mdresx.online sub.mdresx.online;
    return 301 https://$host$request_uri;
}
server {
    listen 8443 ssl;
    http2 on;
    server_name marzban.mdresx.online sub.mdresx.online;
    ssl_certificate /root/.acme.sh/mdresx.online_ecc/fullchain.cer;
    ssl_certificate_key /root/.acme.sh/mdresx.online_ecc/mdresx.online.key;
    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
